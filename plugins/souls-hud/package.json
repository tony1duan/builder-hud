{
  "name": "dsh-plugin-souls-hud",
  "version": "0.4.0",
  "private": true,
  "description": "Souls Style \u2014 the Dark Souls III style covenant-medal vitals cluster that BuilderHUD ships",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": {
      "default": "./lib/host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "data",
    "assets",
    "locale",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "hud",
    "sidebar",
    "status-bar",
    "dark-souls"
  ],
  "author": "tony1duan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tony1duan/builder-hud.git",
    "directory": "plugins/souls-hud"
  },
  "homepage": "https://github.com/tony1duan/builder-hud/blob/main/plugins/souls-hud/README.md",
  "bugs": {
    "url": "https://github.com/tony1duan/builder-hud/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "funding": [
    {
      "type": "ko-fi",
